  m_Script: {fileID: 11500000, guid: 4e24e2a0c0811c345a3aa4f276b2fa30, type: 3}
  m_Name: Conv_Level02
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  firstVisitKey: level_02_start
  mood: 1
  lines:
  - text: This place is far larger than the ruins before... and far more dangerous.
      I can feel it.
    portraitOverride: {fileID: 0}
  - text: There are stronger creatures here. I can hear them. Some of them are unlike
      anything I have faced before.
    portraitOverride: {fileID: 0}
  - text: My friends have to be somewhere beyond this wasteland. I push forward — no
      matter what stands in my way.
    portraitOverride: {fileID: 0}
